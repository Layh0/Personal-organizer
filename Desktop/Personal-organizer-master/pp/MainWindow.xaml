<Window x:Class="pp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Личный Органайзер" Height="600" Width="1000">
    <Grid Margin="10">
        <TabControl>

            <!-- ================= Вкладка Контакты ================= -->
            <TabItem Header="Контакты">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal" Margin="5">
                        <TextBox Width="200" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />

                        <Button Content="➕ Добавить" Command="{Binding AddContactCommand}" Margin="10,0,5,0" Width="120"/>
                        <Button Content="🗑️ Удалить" Command="{Binding DeleteContactCommand}" Margin="0,0,5,0" Width="120"/>

                        <Button Content="Импорт vCard" Command="{Binding ImportVCardCommand}" Margin="10,0,5,0"/>
                        <Button Content="Экспорт vCard" Command="{Binding ExportVCardCommand}"/>
                        <Button Content="🗺 Открыть на карте" Command="{Binding OpenMapCommand}" Margin="10,0,5,0" Width="150"/>
                    </StackPanel>

                    <DataGrid Grid.Row="1" ItemsSource="{Binding Contacts}" SelectedItem="{Binding SelectedContact}" 
                              AutoGenerateColumns="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Имя" Binding="{Binding FirstName}"/>
                            <DataGridTextColumn Header="Фамилия" Binding="{Binding LastName}"/>
                            <DataGridTextColumn Header="Телефон" Binding="{Binding Phone}"/>
                            <DataGridTextColumn Header="Email" Binding="{Binding Email}"/>
                            <DataGridTextColumn Header="День Рождения" Binding="{Binding Birthday, StringFormat=dd.MM.yyyy}"/>
                            <DataGridTextColumn Header="Адрес" Binding="{Binding Address}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- ================= Вкладка Задачи ================= -->
            <TabItem Header="Задачи">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal" Margin="5">
                        <Button Content="➕ Добавить задачу" Command="{Binding AddTaskCommand}" Margin="0,0,5,0" Width="150"/>
                        <Button Content="🗑️ Удалить" Command="{Binding DeleteTaskCommand}" Margin="0,0,5,0" Width="120"/>
                        <Button Content="Отметить выполнение" Command="{Binding CompleteTaskCommand}" Width="150"/>
                    </StackPanel>

                    <DataGrid Grid.Row="1" ItemsSource="{Binding Tasks}" SelectedItem="{Binding SelectedTask}" 
                              AutoGenerateColumns="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Задача" Binding="{Binding Title}" Width="*"/>
                            <DataGridTextColumn Header="Дедлайн" Binding="{Binding Deadline, StringFormat=dd.MM.yyyy HH:mm}"/>
                            <DataGridCheckBoxColumn Header="Выполнено" Binding="{Binding IsCompleted}" Width="80"/>
                            <DataGridTextColumn Header="Контакт" Binding="{Binding Contact.FirstName}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- ================= Вкладка Заметки ================= -->
            <TabItem Header="Заметки">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal" Margin="5">
                        <Button Content="➕ Добавить заметку" Command="{Binding AddNoteCommand}" Margin="0,0,5,0" Width="150"/>
                        <Button Content="🗑️ Удалить" Command="{Binding DeleteNoteCommand}" Width="120"/>
                    </StackPanel>

                    <DataGrid Grid.Row="1" ItemsSource="{Binding Notes}" SelectedItem="{Binding SelectedNote}" 
                              AutoGenerateColumns="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Цвет" Width="60">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="{Binding ColorTag}" 
                                                Width="40" Height="20" 
                                                BorderBrush="Gray" 
                                                BorderThickness="1"
                                                CornerRadius="3"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Заголовок" Binding="{Binding Title}" Width="*"/>
                            <DataGridTextColumn Header="Категория" Binding="{Binding Category.Name}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>